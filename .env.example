# Origines du frontend autorisées à appeler l'API (séparées par des virgules).
ALLOWED_ORIGINS=http://localhost:3000

# Dossier de travail et base de l'historique.
# OUT_DIR=/data/fichiers
# DB_PATH=/data/historique.sqlite3

# Capacité du serveur.
MAX_CONCURRENT=3
MAX_ACTIVE_PER_VISITOR=3
MAX_QUEUE=40

# Bornes d'un téléchargement.
MAX_DURATION=10800
MAX_FILESIZE=2G
MAX_PLAYLIST_ITEMS=50
JOB_TIMEOUT=1800
FILE_TTL=1800

# Demandes par adresse IP.
INFO_PER_MINUTE=30
DOWNLOADS_PER_HOUR=40
